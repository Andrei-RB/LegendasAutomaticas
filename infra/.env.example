# Copie para infra/.env e preencha. O arquivo .env nunca é versionado.
# Gere segredos com: openssl rand -hex 32  (use apenas hexadecimal: a senha entra em URLs)

# Obrigatórias
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=
SENHA_REDIS=
JWT_SECRET=

# Sessão (JWT_SECRET exige ao menos 32 bytes). Navegadores aceitam Secure em localhost.
JWT_EXPIRA_MINUTOS=480
COOKIE_SECURE=true
# Cadastro só é aceito sem usuários existentes ou com PERMITIR_CADASTRO=true
PERMITIR_CADASTRO=false

# Claude: subscription (assinatura), api (chave paga) ou off
CLAUDE_MODE=subscription
CLAUDE_CHAMADAS_DIA=50
# Token da assinatura (gerado com `claude setup-token`); vazio desativa
CLAUDE_CODE_OAUTH_TOKEN=
# Só no modo api; com CLAUDE_MODE=subscription esta variável deve ficar vazia
ANTHROPIC_API_KEY=

# Opcionais
GEMINI_API_KEY=
# Necessário apenas para modelos restritos do Hugging Face (ex.: diarização)
HF_TOKEN=
