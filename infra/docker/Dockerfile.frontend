FROM node:22.23.2-alpine3.24 AS construcao

WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund

COPY frontend/ ./
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.31.7-alpine3.24

COPY infra/frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY infra/frontend/cabecalhos.conf /etc/nginx/snippets/cabecalhos.conf
COPY --from=construcao /app/dist /usr/share/nginx/html
